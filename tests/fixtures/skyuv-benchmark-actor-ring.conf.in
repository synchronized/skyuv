thread = 4
logger = nil
harbor = 0
bootstrap = "snlua bootstrap"
start = "skyuv_benchmark_actor_ring"

benchmark_warmup = "$SKYUV_BENCHMARK_WARMUP"
benchmark_duration = "$SKYUV_BENCHMARK_DURATION"
benchmark_iterations = "$SKYUV_BENCHMARK_ITERATIONS"
benchmark_actors = "$SKYUV_BENCHMARK_ACTORS"

cpath = "@SKYUV_PORTABLE_BINARY_DIR@/cservice/?@SKYUV_PORTABLE_MODULE_SUFFIX@"
lua_path = "@SKYUV_PORTABLE_SOURCE_DIR@/lualib/?.lua;@SKYUV_PORTABLE_SOURCE_DIR@/lualib/?/init.lua"
lua_cpath = "@SKYUV_PORTABLE_BINARY_DIR@/luaclib/?@SKYUV_PORTABLE_MODULE_SUFFIX@"
luaservice = "@SKYUV_PORTABLE_SOURCE_DIR@/service/?.lua;@SKYUV_EXAMPLE_SOURCE_DIR@/?.lua"
lualoader = "@SKYUV_PORTABLE_SOURCE_DIR@/lualib/loader.lua"
