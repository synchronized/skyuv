From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: skyuv <skyuv@example.com>
Date: Thu, 13 Aug 2026 00:00:00 +0800
Subject: [PATCH] Make gate variable buffers portable

---
 service-src/service_gate.c | 39 ++++++++++++++++++++++++++-------------
 1 file changed, 26 insertions(+), 13 deletions(-)

diff --git a/service-src/service_gate.c b/service-src/service_gate.c
index a5b2315..16fa776 100644
--- a/service-src/service_gate.c
+++ b/service-src/service_gate.c
@@ -87,13 +87,16 @@ _forward_agent(struct gate * g, int fd, uint32_t agentaddr, uint32_t clientaddr)
 static void
 _ctrl(struct gate * g, const void * msg, int sz) {
 	struct skynet_context * ctx = g->ctx;
-	char tmp[sz+1];
+	if (sz == 0)
+		return;
+	char * tmp = skynet_malloc(sz+1);
 	memcpy(tmp, msg, sz);
 	tmp[sz] = '\0';
 	char * command = tmp;
 	int i;
-	if (sz == 0)
-		return;
 	for (i=0;i<sz;i++) {
 		if (command[i]==' ') {
 			break;
@@ -107,14 +110,14 @@ _ctrl(struct gate * g, const void * msg, int sz) {
 		if (id>=0) {
 			skynet_socket_close(ctx, uid);
 		}
-		return;
+		goto done;
 	}
 	if (memcmp(command,"forward",i)==0) {
 		_parm(tmp, sz, i);
 		char * client = tmp;
 		char * idstr = strsep(&client, " ");
 		if (client == NULL) {
-			return;
+			goto done;
 		}
 		int id = strtol(idstr , NULL, 10);
 		char * agent = strsep(&client, " ");
@@ -125,13 +128,13 @@ _ctrl(struct gate * g, const void * msg, int sz) {
 		uint32_t agent_handle = strtoul(agent+1, NULL, 16);
 		uint32_t client_handle = strtoul(client+1, NULL, 16);
 		_forward_agent(g, id, agent_handle, client_handle);
-		return;
+		goto done;
 	}
 	if (memcmp(command,"broker",i)==0) {
 		_parm(tmp, sz, i);
 		g->broker = skynet_queryname(ctx, command);
-		return;
+		goto done;
 	}
 	if (memcmp(command,"start",i) == 0) {
 		_parm(tmp, sz, i);
@@ -140,7 +143,7 @@ _ctrl(struct gate * g, const void * msg, int sz) {
 		if (id>=0) {
 			skynet_socket_start(ctx, uid);
 		}
-		return;
+		goto done;
 	}
 	if (memcmp(command, "close", i) == 0) {
 		if (g->listen_id >= 0) {
@@ -148,9 +151,11 @@ _ctrl(struct gate * g, const void * msg, int sz) {
 			g->listen_id = -1;
 		}
-		return;
+		goto done;
 	}
 	skynet_error(ctx, "[gate] Unknown command : %s", command);
+done:
+	skynet_free(tmp);
 }
@@ -290,7 +295,7 @@ _cb(struct skynet_context * ctx, void * ud, int type, int session, uint32_t sour
 		}
 		// The last 4 bytes in msg are the id of socket, write following bytes to it
-		const uint8_t * idbuf = msg + sz - 4;
+		const uint8_t * idbuf = (const uint8_t *)msg + sz - 4;
 		uint32_t uid = idbuf[0] | idbuf[1] << 8 | idbuf[2] << 16 | idbuf[3] << 24;
@@ -346,8 +351,10 @@ gate_init(struct gate *g , struct skynet_context * ctx, char * parm) {
 		return 1;
 	int max = 0;
 	int sz = strlen(parm)+1;
-	char watchdog[sz];
-	char binding[sz];
+	char * parse_buffer = skynet_malloc(sz * 2);
+	char * watchdog = parse_buffer;
+	char * binding = parse_buffer + sz;
 	int client_tag = 0;
@@ -356,14 +363,17 @@ gate_init(struct gate *g , struct skynet_context * ctx, char * parm) {
 	if (n<4) {
 		skynet_error(ctx, "Invalid gate parm %s",parm);
+		skynet_free(parse_buffer);
 		return 1;
 	}
 	if (max <=0 ) {
 		skynet_error(ctx, "Need max connection");
+		skynet_free(parse_buffer);
 		return 1;
 	}
 	if (header != 'S' && header !='L') {
 		skynet_error(ctx, "Invalid data header style");
+		skynet_free(parse_buffer);
 		return 1;
 	}
@@ -378,6 +388,7 @@ gate_init(struct gate *g , struct skynet_context * ctx, char * parm) {
 		if (g->watchdog == 0) {
 			skynet_error(ctx, "Invalid watchdog %s",watchdog);
+			skynet_free(parse_buffer);
 			return 1;
 		}
@@ -400,5 +411,7 @@ gate_init(struct gate *g , struct skynet_context * ctx, char * parm) {
 
 	skynet_callback(ctx,g,_cb);
 
-	return start_listen(g,binding);
+	int result = start_listen(g,binding);
+	skynet_free(parse_buffer);
+	return result;
 }
-- 
2.50.1.windows.1
