 static int
+connect_error(lua_State *L, const char *addr, int port, socket_fd fd) {
+#ifdef _WIN32
+	int native_error = WSAGetLastError();
+	if (fd != INVALID_SOCKET)
+		closesocket(fd);
+#else
+	int native_error = errno;
+	if (fd >= 0)
+		close(fd);
+#endif
+	int error = uv_translate_sys_error(native_error);
+	return luaL_error(L, "Connect %s %d failed: %s (%s, native error %d)",
+		addr, port, uv_strerror(error), uv_err_name(error), native_error);
+}
+
+static int
 lconnect(lua_State *L) {
 	const char * addr = luaL_checkstring(L, 1);
 	int port = luaL_checkinteger(L, 2);
 	socket_fd fd = socket(AF_INET,SOCK_STREAM,0);
+#ifdef _WIN32
+	if (fd == INVALID_SOCKET)
+#else
+	if (fd < 0)
+#endif
+		return connect_error(L, addr, port, fd);
 	struct sockaddr_in my_addr;
 
 	my_addr.sin_addr.s_addr=inet_addr(addr);
