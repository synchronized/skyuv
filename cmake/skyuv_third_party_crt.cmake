# CRT 弃用标记仅按第三方源码归属处理，不影响自有代码和其他警告。
function(skyuv_third_party_crt directory)
  if(NOT WIN32 OR NOT (MSVC OR CMAKE_C_SIMULATE_ID STREQUAL "MSVC"))
    return()
  endif()
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS targets)
    get_target_property(type ${target} TYPE)
    if(type STREQUAL "INTERFACE_LIBRARY" OR type STREQUAL "UTILITY")
      continue()
    endif()
    get_target_property(sources ${target} SOURCES)
    get_target_property(source_directory ${target} SOURCE_DIR)
    set(third_party_sources)
    set(only_third_party TRUE)
    foreach(source IN LISTS sources)
      if(source MATCHES "^\\$<")
        set(only_third_party FALSE)
        continue()
      endif()
      get_filename_component(absolute_source "${source}" ABSOLUTE BASE_DIR "${source_directory}")
      file(TO_CMAKE_PATH "${absolute_source}" absolute_source)
      string(FIND "${absolute_source}" "${SKYUV_SOURCE_DIR}/3rd/" original_prefix)
      string(FIND "${absolute_source}" "${SKYUV_BINARY_DIR}/3rd/" generated_prefix)
      if(original_prefix EQUAL 0 OR generated_prefix EQUAL 0)
        list(APPEND third_party_sources "${absolute_source}")
      else()
        set(only_third_party FALSE)
      endif()
    endforeach()
    if(third_party_sources)
      if(only_third_party)
        target_compile_definitions(${target} PRIVATE _CRT_SECURE_NO_WARNINGS)
      else()
        set_property(SOURCE ${third_party_sources} TARGET_DIRECTORY ${target}
          APPEND PROPERTY COMPILE_DEFINITIONS _CRT_SECURE_NO_WARNINGS)
      endif()
    endif()
  endforeach()
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    skyuv_third_party_crt("${child}")
  endforeach()
endfunction()
