root = "@SKYUV_SKYNET_RUNTIME_SOURCE_DIR@/"
thread = 4
logger = nil
harbor = 0
start = "skyuv_tcp_events"
bootstrap = "snlua bootstrap"
luaservice = "@SKYUV_EXAMPLE_SOURCE_DIR@/?.lua;"..root.."service/?.lua;"..root.."test/?.lua;"..root.."examples/?.lua"
lualoader = root .. "lualib/loader.lua"
lua_path = root .. "lualib/?.lua;" .. root .. "lualib/?/init.lua"
lua_cpath = "@SKYUV_SKYNET_RUNTIME_BINARY_DIR@/luaclib/?.so"
cpath = "@SKYUV_SKYNET_RUNTIME_BINARY_DIR@/cservice/?.so"
